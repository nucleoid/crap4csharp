<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>crap4csharp</ToolCommandName>
    <PackageId>Crap4CSharp.Tool</PackageId>
    <Version>0.1.0</Version>
    <Authors>Crap4CSharp contributors</Authors>
    <Description>Calculate CRAP metrics for C# methods using Roslyn and Coverlet/OpenCover reports.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/nucleoid/crap4csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp;dotnet-tool;coverage;maintainability;crap</PackageTags>
    <PackageReleaseNotes>Unreleased candidate: project-aware post-task checks, captured replay and current revalidation. Exact-head Windows/Linux packaged acceptance and independent review are required before release. See docs/releases.md.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Crap4CSharp.Core/Crap4CSharp.Core.csproj" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../ATTRIBUTION.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Crap4CSharp.Tests" />
  </ItemGroup>
  <Import Project="../../scripts/native-tool-package.targets" />
</Project>
