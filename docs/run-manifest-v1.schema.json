{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nucleoid/crap4csharp/docs/run-manifest-v1.schema.json",
  "title": "Crap4CSharp run manifest v1",
  "type": "object",
  "required": ["manifestSchemaVersion", "identityAlgorithm", "producer", "capture", "revision", "roots", "contexts", "builds", "executions", "artifacts", "evaluationInputs"],
  "properties": {
    "manifestSchemaVersion": { "const": "1.0" },
    "identityAlgorithm": { "const": "sha256-canonical-v1" },
    "manifestHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "producer": { "type": "object", "required": ["tool", "toolVersion", "complexityRuleset", "contextProtocol", "coverageProtocol", "pathProtocol"] },
    "capture": { "type": "object", "required": ["state", "captureConsistent", "actualBindingComplete", "failureReasons"] },
    "revision": { "type": "object", "required": ["kind", "repositoryIdentity", "workspaceIdentity"] },
    "roots": { "type": "array", "items": { "type": "object" } },
    "contexts": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "builds": { "type": "array", "items": { "type": "object" } },
    "executions": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "evaluationInputs": { "type": "object" }
  },
  "additionalProperties": true
}
